.env
.env.local
.env.production
.env.*.local
*.pem
*.key

# Supabase 로컬 개발
.supabase/
supabase/.temp/

# IDE/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node
node_modules/

# 빌드/캐시
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
.vercel/

# 로그/테스트
*.log
npm-debug.log*
pnpm-debug.log*
coverage/
.nyc_output/

